@inject CorporateStarter.Shared.Localization.UiText L
@namespace CorporateStarter.Client.Browser.Components
@using Microsoft.AspNetCore.Components.Web

@if (_status == GateStatus.Ready)
{
    @ChildContent
}
else
{
    <section class="browser-gate" aria-label="@L["Browser check"]">
        <div role="status" aria-live="polite">
            @switch (_status)
            {
                case GateStatus.Checking:
                    <p>@L["Checking browser capabilities…"]</p>
                    break;

                case GateStatus.Unsupported:
                    <p>@L["A secure context and Web Locks support are required."]</p>
                    <p>@L["Open the application over HTTPS in a supported browser."]</p>
                    break;

                case GateStatus.Unavailable:
                    <p>@L["Could not check the browser. Check your connection and retry."]</p>
                    break;
            }
        </div>

        @if (_status == GateStatus.Unavailable)
        {
            <button type="button" @onclick="RetryAsync">
                @L["Retry"]
            </button>
        }
    </section>
}