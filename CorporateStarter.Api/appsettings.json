{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5435;Database=corporate_starter;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "CorporateStarter",
    "Audience": "CorporateStarter.Web",
    "Secret": "CHANGE_ME_USE_USER_SECRETS_OR_ENVIRONMENT_VARIABLE",
    "ExpirationMinutes": 3
  },
  "InitialAdmin": {
    "Login": "admin",
    "Email": "admin@corporatestarter.local",
    "DisplayName": "Administrator",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Csrf": {
    "CookieName": "__Host-corporate_starter_csrf",
    "HeaderName": "X-CSRF-TOKEN",
    "SecureCookie": true,
    "SameSite": "Strict"
  },
  "RefreshTokens": {
    "CookieName": "__Host-corporate_starter_refresh",
    "LifetimeDays": 14,
    "SecureCookie": true,
    "SameSite": "Strict"
  },
  "LoginAttempts": {
    "WindowMinutes": 15,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "ProgressiveDelayBaseMilliseconds": 250,
    "MaxProgressiveDelayMilliseconds": 3000
  },
  "JwtSigningKeys": {
    "ActiveKeyId": "dev-2026-08",
    "Keys": [
      {
        "KeyId": "dev-2026-08",
        "Secret": "CHANGE_ME_DEVELOPMENT_ONLY_32_BYTES_MINIMUM_SECRET",
        "IsEnabled": true
      }
    ]
  },
  "SessionIdle": {
    "TimeoutMinutes": 0
  },
  "PasswordPolicy": {
    "MinimumLength": 12,
    "MaximumLength": 128,
    "RequireUppercase": true,
    "RequireLowercase": true,
    "RequireDigit": true,
    "RequireNonAlphanumeric": true,
    "RejectLoginInPassword": true,
    "RejectEmailLocalPartInPassword": true,
    "RejectCommonPasswords": true
  },
  "PasswordHistory": {
    "HistoryCount": 5
  },
  "AllowedHosts": "*"
