@inject CorporateStarter.Client.Core.Auth.ProfilePreferences Preferences
@using CorporateStarter.Client.Core.Audit
@using CorporateStarter.Shared.Dtos.Audit
@using CorporateStarter.Client.UI.Components.Details

<RecordDetailsDialog TItem="AuditLogListItemDto" Title="@L["Change details"]" Load="@(ct => Client.GetDetailsAsync(ChangeId, ct))">
    <ChildContent Context="item">
        <dl class="change-metadata">
            <dt>@L.Format("Date ({0})", Preferences.ZoneLabel)</dt><dd>@Preferences.Format(item.CreatedAtUtc)</dd>
            <dt>@L["Entity"]</dt><dd>@item.EntityName</dd>
            <dt>@L["Record"]</dt><dd>@(item.EntityDisplayName ?? item.EntityId)</dd>
            <dt>@L["Record ID"]</dt><dd><CopyIdentifier Value="@item.EntityId" Label="@L["record ID"]" /></dd>
            <dt>@L["Change ID"]</dt><dd><CopyIdentifier Value="@(item.Id.ToString())" Label="@L["change ID"]" /></dd>
            <dt>@L["Correlation ID"]</dt><dd><CopyIdentifier Value="@item.CorrelationId" Label="@L["correlation ID"]" /></dd>
            <dt>@L["Action"]</dt><dd>@item.Action</dd>
            <dt>@L["User"]</dt><dd>@(item.UserEmail ?? "—")</dd>
        </dl>
        @{ var comparison = ChangeComparison.Parse(item.OldValuesJson, item.NewValuesJson); }
        @if (comparison.InvalidJson)
        {
            <MudAlert Severity="Severity.Warning">@L["The stored snapshot is not valid JSON and cannot be compared."]</MudAlert>
        }
        else
        {
            <MudSwitch @bind-Value="_onlyChanged" Color="Color.Primary" Label="@L["Changed fields only"]" />
            <div class="change-values">
                <table>
                    <thead><tr><th>@L["Field"]</th><th>@L["Before"]</th><th>@L["After"]</th></tr></thead>
                    <tbody>
                        @foreach (var row in comparison.Rows.Where(x => !_onlyChanged || x.Changed))
                        {
                            <tr class="@(row.Changed ? "changed" : null)"><th>@row.Field</th><td><pre>@row.Before</pre></td><td><pre>@row.After</pre></td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!comparison.Rows.Any(x => !_onlyChanged || x.Changed))
            {
                <MudText>@L["No field differences recorded."]</MudText>
            }
        }
    </ChildContent>
</RecordDetailsDialog>