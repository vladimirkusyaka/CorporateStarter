<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Delete @(_items.Length == 1 ? "Country" : "Countries")</MudText></TitleContent>
    <DialogContent>
        <MudText>@Confirmation</MudText>
        @if (_busy)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
            <MudText Class="mt-2" role="status">Deleting… @_completed / @_items.Length</MudText>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" role="alert">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Disabled="@_busy">@(_attempted ? "Close" : "Cancel")</MudButton>
        @if (!_attempted)
        {
            <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(!CanDelete)"
                       OnClick="DeleteAsync">Delete</MudButton>
        }
    </DialogActions>
</MudDialog>
