@inject CorporateStarter.Client.Core.Auth.ProfilePreferences Preferences
@using CorporateStarter.Client.Core.Audit
@using CorporateStarter.Shared.Dtos.Audit
@using CorporateStarter.Client.UI.Components.Details


<RecordDetailsDialog TItem="SecurityEventListItemDto" Title="Security event" Load="@(ct => Client.GetDetailsAsync(EventId, ct))">
    <ChildContent Context="item">
        <dl class="event-metadata">
            <dt>Date (@Preferences.ZoneLabel)</dt>
            <dd>@Preferences.Format(item.CreatedAtUtc)</dd>
            <dt>Event</dt>
            <dd>@item.EventType</dd>
            <dt>Severity</dt>
            <dd>@item.Severity</dd>
            <dt>Outcome</dt>
            <dd>@item.Outcome</dd>
            <dt>User</dt>
            <dd>@(item.SubjectUserDisplayName ?? item.SubjectUserEmail ?? item.SubjectUserId?.ToString() ?? "Not recorded")</dd>
            <dt>Email</dt><dd>@(item.SubjectUserEmail ?? "Not recorded")</dd>
            <dt>Event ID</dt><dd><CopyIdentifier Value="@(item.Id.ToString())" Label="event ID" /></dd>
            <dt>User ID</dt>
            <dd><CopyIdentifier Value="@(item.SubjectUserId?.ToString())" Label="user ID" /></dd>
            <dt>Session ID</dt>
            <dd>@(item.AuthSessionId?.ToString() ?? "Not recorded")</dd>
            <dt>Token family ID</dt>
            <dd>@(item.RefreshTokenFamilyId?.ToString() ?? "Not recorded")</dd>
            <dt>Correlation ID</dt>
            <dd><CopyIdentifier Value="@item.CorrelationId" Label="correlation ID" /></dd>
            <dt>IP address</dt>
            <dd>@(item.IpAddress ?? "Not recorded")</dd>
            <dt>User agent</dt>
            <dd>@(item.UserAgent ?? "Not recorded")</dd>
        </dl>
        <MudText Typo="Typo.subtitle1">Additional details</MudText>
        <JsonDetails Value="@item.DetailsJson" />
    </ChildContent>
</RecordDetailsDialog>