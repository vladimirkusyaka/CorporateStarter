@using CorporateStarter.Client.UI.Components.Editors
@using CorporateStarter.Client.UI.Components.Lookups
@using CorporateStarter.Shared.Dtos.Directory.Companies
@inherits RecordEditorBase<UpdateCompanyRequest, CompanyDetailsDto>

<EditorDialogFrame @ref="_frame" Title="@(IsEditing ? "Edit company" : "Add company")"
                   Loading="_loadingDetails" Loaded="_loaded" Saving="_saving" Blocked="@(Blocked || _validating)" SessionReady="_sessionReady"
                   Uncertain="_uncertain" ConfirmDiscard="_confirmDiscard" Error="@_error"
                   Close="CloseAsync" Save="SaveTabbedAsync" Retry="LoadDetailsAsync" KeepEditing="KeepEditing" Discard="Discard">
    <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="ChangeTab" KeepPanelsAlive="true" Elevation="0" TabPanelsClass="pt-4">
        <MudTabPanel Text="@L["Details"]" Disabled="@(Blocked || _confirmDiscard || _validating)">
            <MudTextField @bind-Value="_model.Name" Label="@L["Name"]" MaxLength="256" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" Validation="@(new Func<string, string?>(Required))" />
            <MudTextField @bind-Value="_model.Code" Label="@L["Code"]" MaxLength="100" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.LegalName" Label="@L["Legal name"]" MaxLength="256" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.TaxNumber" Label="@L["Tax number"]" MaxLength="100" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.VatId" Label="@L["VAT ID"]" MaxLength="100" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.Description" Label="@L["Description"]" MaxLength="2000" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" Lines="3" />
            @if (IsEditing && _capabilities.ViewInactive)
            {
                <MudSwitch @bind-Value="_model.IsActive" Color="Color.Primary" Disabled="@(Blocked || !CanChangeActive)" Label="@L["Active"]" />
            }
        </MudTabPanel>
        <MudTabPanel Text="@L["Contacts"]" Disabled="@(Blocked || _confirmDiscard || _validating)">
            <MudTextField @bind-Value="_model.Email" Label="@L["Email"]" MaxLength="256" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.Phone" Label="@L["Phone"]" MaxLength="50" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.Website" Label="@L["Website"]" MaxLength="256" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
        </MudTabPanel>
        <MudTabPanel Text="@L["Address"]" Disabled="@(Blocked || _confirmDiscard || _validating)">
            <MudTextField @bind-Value="_model.Street" Label="@L["Street"]" MaxLength="256" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.HouseNumber" Label="@L["House number"]" MaxLength="50" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.PostalCode" Label="@L["Postal code"]" MaxLength="20" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <ReferenceLookup Label="@L["City"]" Value="_city" ValueChanged="CityChanged" Search="Client.SearchCitiesAsync" Required="false" Disabled="Blocked" />
        </MudTabPanel>
    </MudTabs>
</EditorDialogFrame>
