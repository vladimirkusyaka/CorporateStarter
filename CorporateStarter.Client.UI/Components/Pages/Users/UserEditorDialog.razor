@using CorporateStarter.Client.UI.Components.Editors
@using CorporateStarter.Client.UI.Components.Lookups
@using CorporateStarter.Shared.Dtos.Security.Users
@inherits RecordEditorBase<CreateUserRequest, Guid>

<EditorDialogFrame @ref="_frame" Title="@(IsEditing ? "Edit user" : "Add user")"
    Loading="_loadingDetails" Loaded="_loaded" Saving="_saving" Blocked="@(Blocked || _validating)" SessionReady="_sessionReady"
    Uncertain="_uncertain" ConfirmDiscard="_confirmDiscard" Error="@_error"
    Close="CloseAsync" Save="SaveTabbedAsync" Retry="LoadDetailsAsync" KeepEditing="KeepEditing" Discard="Discard">
    <MudTabs ActivePanelIndex="_tab" ActivePanelIndexChanged="ChangeTab" KeepPanelsAlive="true" Elevation="0" TabPanelsClass="pt-4">
        <MudTabPanel Text="Details" Disabled="@(Blocked || _confirmDiscard || _validating)">
            <MudTextField @bind-Value="_model.Login" Label="Login" MaxLength="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Disabled="Blocked" Validation="@(new Func<string, string?>(LoginError))" />
            <MudTextField @bind-Value="_model.DisplayName" Label="Display name" MaxLength="256" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Disabled="Blocked" />
            <MudTextField @bind-Value="_model.Email" Label="Email" MaxLength="256" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Immediate="true" Disabled="Blocked" Validation="@(new Func<string, string?>(EmailError))" />
            @if (!IsEditing)
            {
                <MudTextField @bind-Value="_model.Password" Label="Password" InputType="InputType.Password" autocomplete="new-password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="Blocked" Validation="@(new Func<string, string?>(Required))" />
                <MudTextField @bind-Value="_confirmation" Label="Confirm password" InputType="InputType.Password" autocomplete="new-password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="Blocked" Validation="@(new Func<string, string?>(ConfirmationError))" />
            }
            <MudSwitch @bind-Value="_model.IsActive" Color="Color.Primary" Disabled="@(Blocked || IsSelf)" Label="Active" />
            @if (_model.PersonId is not null)
            {
                <MudText Typo="Typo.body2">Person: @(_personName ?? "Linked person")</MudText>
            }
        </MudTabPanel>
        <MudTabPanel Text="Roles" Disabled="@(Blocked || _confirmDiscard || _validating)">
            <ReferenceTreeSelect Label="Roles" Options="_options" Selected="_selected" SelectedChanged="RolesChanged" Disabled="Blocked" />
        </MudTabPanel>
    </MudTabs>
</EditorDialogFrame>
