@using CorporateStarter.Client.UI.Components.Editors
@using CorporateStarter.Shared.Dtos.Security.Users
@inherits RecordEditorBase<ChangeUserPasswordRequest, Guid>

<EditorDialogFrame @ref="_frame" Title="Change password" Loading="_loadingDetails" Loaded="_loaded" Saving="_saving"
    Blocked="Blocked" SessionReady="_sessionReady" Uncertain="_uncertain" ConfirmDiscard="_confirmDiscard" Error="@_error"
    Close="CloseAsync" Save="SaveAsync" Retry="LoadDetailsAsync" KeepEditing="KeepEditing" Discard="Discard">
    <MudText>@_login</MudText>
    <MudTextField @bind-Value="_model.NewPassword" Label="New password" InputType="InputType.Password" autocomplete="new-password"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="Blocked" Validation="@(new Func<string, string?>(Required))" />
    <MudTextField @bind-Value="_confirmation" Label="Confirm password" InputType="InputType.Password" autocomplete="new-password"
                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="Blocked" Validation="@(new Func<string, string?>(ConfirmationError))" />
</EditorDialogFrame>
