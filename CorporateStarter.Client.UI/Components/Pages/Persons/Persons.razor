@page "/persons"
@using CorporateStarter.Client.UI.Components.Tables
@using CorporateStarter.Shared.Dtos.Directory.Persons

<PageTitle>Persons</PageTitle>
<ReferenceTable TItem="PersonListItemDto" TColumn="Column" Client="Client" Columns="Columns"
                ItemId="@(x => x.Id)" ItemName="@(x => string.Join(" ", new[] { x.FirstName, x.MiddleName, x.LastName }.Where(s => !string.IsNullOrWhiteSpace(s))))" Title="Persons" Singular="person"
                OpenEditor="OpenEditorAsync" SavedId="@(value => (value as PersonDetailsDto)?.Id)" />
