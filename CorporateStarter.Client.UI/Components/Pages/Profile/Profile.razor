@page "/profile"
@using CorporateStarter.Client.Core.Auth
@using CorporateStarter.Shared.Dtos.Auth
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Profile</PageTitle>
<div class="profile-page">
    <MudText Typo="Typo.h5" Class="mb-4">Profile</MudText>
    @if (_profile is null)
    {
        @if (_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert><MudButton OnClick="LoadAsync" Disabled="_busy">Retry</MudButton> }
        else { <MudProgressCircular Indeterminate="true" aria-label="Loading profile" /> }
    }
    else
    {
        <MudPaper Outlined="true" Class="profile-panel">
            <MudTabs KeepPanelsAlive="true" @bind-ActivePanelIndex="_tab">
                <MudTabPanel Text="Account" Disabled="_busy">
                    <div class="profile-fields">
                        <MudTextField @bind-Value="_displayName" Label="Display name" MaxLength="256" Immediate="true" Disabled="_busy" Variant="Variant.Outlined" />
                        <MudTextField Value="@_profile.Account.Login" Label="Login" ReadOnly="true" Variant="Variant.Outlined" />
                        <MudTextField Value="@_profile.Account.Email" Label="Email" ReadOnly="true" Variant="Variant.Outlined" />
                        <MudTextField Value="@(_profile.PersonName ?? "Not linked")" Label="Person" ReadOnly="true" Variant="Variant.Outlined" />
                        @if (_profile.CompanyName is not null) { <MudText>Company: @_profile.CompanyName</MudText> }
                        @if (_profile.PositionName is not null) { <MudText>Position: @_profile.PositionName</MudText> }
                        <MudText Typo="Typo.subtitle2">Roles</MudText>
                        @if (_profile.Account.Roles.Count == 0) { <MudText>No roles assigned.</MudText> }
                        else { <ul>@foreach (var role in _profile.Account.Roles) { <li>@role.Name</li> }</ul> }
                        <MudText Typo="Typo.caption">Login, email, linked person and roles are managed by an administrator.</MudText>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SaveAccountAsync">Save account</MudButton>
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="Appearance" Disabled="_busy">
                    <div class="profile-fields">
                        <MudSelect T="string" @bind-Value="_theme" Label="Theme" Variant="Variant.Outlined" Disabled="_busy">
                            <MudSelectItem Value='@("System")'>System</MudSelectItem>
                            <MudSelectItem Value='@("Light")'>Light</MudSelectItem>
                            <MudSelectItem Value='@("Dark")'>Dark</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="int" @bind-Value="_pageSize" Label="Default rows per page" Variant="Variant.Outlined" Disabled="_busy">
                            <MudSelectItem Value="10">10</MudSelectItem><MudSelectItem Value="20">20</MudSelectItem><MudSelectItem Value="50">50</MudSelectItem>
                        </MudSelect>
                        <MudSelect T="string" @bind-Value="_timeZone" Label="Time zone" Variant="Variant.Outlined" Disabled="_busy">
                            <MudSelectItem Value='@("UTC")'>UTC</MudSelectItem><MudSelectItem Value='@("System")'>Device time zone</MudSelectItem>
                        </MudSelect>
                        <MudText Typo="Typo.caption">Applies to date display in audit lists and details. Date filters and search use UTC. The default page size applies when a table opens.</MudText>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="_busy" OnClick="SaveAppearanceAsync">Save appearance</MudButton>
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="Security" Disabled="_busy">
                    <div class="profile-fields">
                        <MudText Typo="Typo.h6">Change password</MudText>
                        <MudText Typo="Typo.body2">@_profile.PasswordRules</MudText>
                        <MudTextField @bind-Value="_currentPassword" Label="Current password" InputType="InputType.Password" autocomplete="current-password" Immediate="true" MaxLength="128" Disabled="@(_busy || _passwordUncertain)" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_newPassword" Label="New password" InputType="InputType.Password" autocomplete="new-password" Immediate="true" MaxLength="128" Disabled="@(_busy || _passwordUncertain)" Variant="Variant.Outlined" />
                        <MudTextField @bind-Value="_confirmation" Label="Confirm new password" InputType="InputType.Password" autocomplete="new-password" Immediate="true" MaxLength="128" Disabled="@(_busy || _passwordUncertain)" Variant="Variant.Outlined" />
                        <MudAlert Severity="Severity.Info">Changing your password signs you out on all devices, including this one.</MudAlert>
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(_busy || _passwordUncertain)" OnClick="ChangePasswordAsync">Change password</MudButton>
                        @if (_passwordUncertain) { <MudButton OnClick="SignOutAsync" Disabled="_busy">Sign out and sign in again</MudButton> }
                    </div>
                </MudTabPanel>
            </MudTabs>
            @if (_busy) { <MudProgressLinear Indeterminate="true" aria-label="Saving profile" /> }
            @if (_error is not null) { <MudAlert Severity="Severity.Error" Class="ma-4" role="alert">@_error</MudAlert> }
            @if (_message is not null) { <MudAlert Severity="Severity.Success" Class="ma-4" role="status">@_message</MudAlert> }
        </MudPaper>
    }
</div>
