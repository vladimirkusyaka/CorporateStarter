<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Filter @Label</MudText></TitleContent>
    <DialogContent>
        @if (IsChoice)
        {
            <div style="max-height: 45vh; overflow-y: auto;">
                @foreach (var option in Options)
                {
                    <MudCheckBox T="bool" Value="@_selected.Contains(option)"
                                 ValueChanged="@(value => SetSelected(option, value))"
                                 Label="@(option.Length == 0 ? "(Empty)" : option)" Color="Color.Primary" />
                }
            </div>
        }
        else
        {
            <MudTextField T="string" @bind-Value="_text" Label="Contains" Immediate="true" MaxLength="200"
                          Variant="Variant.Outlined" AutoFocus="true" OnKeyDown="OnKeyDown" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Clear">Clear</MudButton>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Apply" Variant="Variant.Filled" Color="Color.Primary">Apply</MudButton>
    </DialogActions>
</MudDialog>
