<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@L.Format("Delete {0}", L[_items.Length == 1 ? Singular : Plural])</MudText></TitleContent>
    <DialogContent>
        <MudText>@Confirmation</MudText>
        @if (_busy)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
            <MudText Class="mt-2" role="status">@L.Format("Deleting… {0} / {1}", _completed, _items.Length)</MudText>
        }
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4" role="alert">@L.Text(_error)</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Disabled="@_busy">@(_attempted ? L["Close"] : L["Cancel"])</MudButton>
        @if (!_attempted)
        {
            <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(!CanDelete)"
                       OnClick="DeleteAsync">@L["Delete"]</MudButton>
        }
    </DialogActions>
</MudDialog>
