@using CorporateStarter.Client.Abstractions.Auth

@inherits LayoutComponentBase

<MudThemeProvider @ref="_themeProvider" Theme="@AppTheme" IsDarkMode="@DarkAppearance" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<span id="cs-connection-state" hidden
      data-connection-stamp="@ConnectionStamp"
      data-connection-ready="@(CanDismissReconnect ? "true" : "false")"></span>

<div class="cs-layout-root" style="color-scheme: @(DarkAppearance ? "dark" : "light")">
    @if (ShowShell)
    {
        <BrandingLoader @key="_snapshot.SessionGeneration" />
        <MudLayout Class="cs-shell">
            <MudAppBar Elevation="0" Dense="true" Class="cs-topbar">
                @if (AppSwitcherVisible)
                {
                    <MudTooltip Text="Applications">
                        <MudIconButton Icon="@Icons.Material.Filled.Apps"
                                       Class="cs-app-switcher"
                                       Size="Size.Small" />
                    </MudTooltip>
                }

                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                               Color="Color.Inherit"
                               Edge="Edge.Start"
                               Size="Size.Small"
                               Class="cs-menu-toggle"
                               OnClick="@ToggleDrawer" />

                <MudText Typo="Typo.subtitle1" Class="cs-brand" title="@PageTitle">@PageTitle</MudText>

                <MudSpacer />

                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="cs-topbar-status">

                    <UserMenu Logout="SignOutAsync"
                              LogoutDisabled="@(_snapshot.UserId is null || _signingOut || IsSigningIn || Session.IsLogoutPending)" />
                </MudStack>
            </MudAppBar>

            <MudDrawer @bind-Open="DrawerOpen"
                       Variant="DrawerVariant.Mini"
                       OpenMiniOnHover="false"
                       Width="250px"
                       MiniWidth="64px"
                       Elevation="0"
                       ClipMode="DrawerClipMode.Always"
                       Class="cs-drawer">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="cs-drawer-header">
                    <MudText Typo="Typo.subtitle2" Class="cs-drawer-brand" title="@PageTitle">@PageTitle</MudText>
                    <MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" Class="cs-drawer-header-icon" />
                </MudStack>

                <PermissionNavigation Expanded="DrawerOpen" @key="_snapshot.SessionGeneration" />
            </MudDrawer>

            <MudMainContent Class="cs-main">
                <MudContainer MaxWidth="MaxWidth.False" Class="cs-page">
                    @if (_snapshot.UserId is not null && _authorizedBody is not null)
                    {
                        <div class="cs-page-content" @key="_snapshot.SessionGeneration"
                             hidden="@(!ShowAuthorizedContent)"
                             inert="@(!IsAuthenticated && !IsQuietSessionCheck)">
                            <SessionContent CanRender="@IsAuthenticated">
                                <ProfileScope><PermissionContent>@_authorizedBody</PermissionContent></ProfileScope>
                            </SessionContent>
                        </div>
                    }
                </MudContainer>
            </MudMainContent>

        </MudLayout>
    }
    @if (ShowLogin)
    {
        <main class="cs-login-page">
            <aside class="cs-login-brand" aria-label="CorporateStarter">
                <div class="cs-login-logo"><MudIcon Icon="@Icons.Material.Filled.Apps" /> CorporateStarter</div>
                <div class="cs-login-message">
                    <p class="cs-login-eyebrow">YOUR WORKSPACE</p>
                    <h2>Everything you need.<br />One place to work.</h2>
                    <p>A shared workspace for your team, your data and your daily work.</p>
                </div>
                <span class="cs-login-version">@BuildVersion</span>
            </aside>
            <section class="cs-login-form-wrap" aria-labelledby="login-title">
                <div class="cs-login-fields">
                    <h1 id="login-title">Sign in</h1>
                    <p class="cs-login-subtitle">Enter your credentials to access your workspace.</p>
                    <MudTextField @ref="_usernameField" @bind-Value="Login"
                                  Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  FullWidth="true" Immediate="true" Disabled="@IsSigningIn"
                                  Class="cs-login-field" OnKeyDown="@OnLoginKeyDown"
                                  autocomplete="username" />
                    <MudTextField @bind-Value="Password" Label="Password"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true"
                                  Immediate="true" Disabled="@IsSigningIn" InputType="InputType.Password"
                                  Class="cs-login-field" OnKeyDown="@OnLoginKeyDown"
                                  autocomplete="current-password" />
                    @if (!string.IsNullOrWhiteSpace(SignInError))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="cs-login-error" role="alert">@SignInError</MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               Disabled="@IsSigningIn" OnClick="@SignInAsync" Class="cs-login-button">
                        @if (IsSigningIn)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <span>Signing in…</span>
                        }
                        else
                        {
                            @:Sign in
                        }
                    </MudButton>
                </div>
            </section>
        </main>
    }
    else if (ShowSessionOverlay)
    {
        <div class="@($"cs-auth-mask{(!ShowShell ? " cs-auth-startup" : string.Empty)}")">
            <MudPaper Class="pa-6" Elevation="10">
                <div role="status" aria-live="polite">
                    @if (_snapshot.Status == ClientAuthStatus.Unavailable)
                    {
                        <p>
                            @(Session.IsLogoutPending
                                ? "Sign-out could not be confirmed. Retry to finish signing out."
                                : "Session verification is unavailable.")
                        </p>

                        <MudButton OnClick="RetrySessionAsync"
                                   Disabled="@(!IsConnectionReady || _restoreInProgress || _signingOut)">
                            Retry
                        </MudButton>
                    }
                    else if (_snapshot.Status ==
                             ClientAuthStatus.UnsupportedEnvironment)
                    {
                        <p>
                            A secure context and Web Locks support are required.
                        </p>
                    }
                    else
                    {
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" aria-hidden="true" />
                        <p>
                            @(Session.IsLogoutPending
                                ? "Signing out…"
                                : "Checking session…")
                        </p>
                    }
                </div>
            </MudPaper>
        </div>
    }
</div>
