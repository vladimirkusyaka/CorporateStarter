<div class="multi-select">
    <label for="@_searchId">@L[Label]</label>
    <input id="@_searchId" type="search" placeholder="@L["Filter options"]" @bind="_search" @bind:event="oninput" disabled="@Disabled" />
    <span role="status">@L.Format("{0} selected", Selected.Count)</span>
    <div class="multi-select-options">
        @foreach (var group in Visible.GroupBy(x => x.Group))
        {
            <fieldset>
                <legend>@L[group.Key]</legend>
                @foreach (var option in group)
                {
                    <label @key="option.Id" class="multi-select-option">
                        <input type="checkbox" checked="@Selected.Contains(option.Id)" disabled="@(Disabled || !option.Enabled)"
                               @onchange="@(e => ChangeAsync(option, e))" />
                        <span>@option.Label</span>
                    </label>
                }
            </fieldset>
        }
        @if (!Visible.Any())
        {
            <p role="status">@L["No matching options."]</p>
        }
    </div>
</div>
