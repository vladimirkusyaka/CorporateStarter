@using CorporateStarter.Client.Core.Serialization

@if (!JsonDisplay.TryFormat(Value, out var formatted))
{
    <MudAlert Severity="Severity.Warning">The stored details are not valid JSON.</MudAlert>
}
else if (formatted.Length == 0)
{
    <MudText>No additional details.</MudText>
}
else
{
    <pre class="json-details">@formatted</pre>
}
